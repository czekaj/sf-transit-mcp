{
  "name": "sf-transit-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Free, keyless San Francisco and Bay Area journey planning for MCP clients",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/czekaj/sf-transit-mcp"
  },
  "type": "module",
  "bin": {
    "sf-transit-mcp": "dist/stdio.js"
  },
  "files": [
    "dist/stdio.js",
    "dist/tools.js",
    "dist/project.js",
    "dist/budget.js",
    "dist/format.js",
    "dist/ui-resource.js",
    "dist/generated/*.js",
    "dist/routing/*.js",
    "assets",
    "docs",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run build:widget && tsx src/stdio.ts",
    "dev:worker": "npm run build:widget && WRANGLER_SEND_METRICS=false wrangler dev --local --env \"\"",
    "build:widget": "node scripts/build-widget.mjs",
    "build:branding": "node scripts/build-branding.mjs",
    "typecheck": "npm run build:widget && tsc --noEmit && tsc --project tsconfig.widget.json",
    "test": "npm run build:widget && vitest run",
    "build": "npm run build:widget && tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "build:worker": "npm run build:widget && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --env \"\"",
    "build:worker:production": "npm run build:widget && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --env production",
    "types:worker": "WRANGLER_SEND_METRICS=false wrangler types --strict-vars=false",
    "preview:widget": "npm run build:widget && node scripts/preview-widget.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "marked": "18.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
