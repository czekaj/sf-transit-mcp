{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sf-transit-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  // Public URLs only. Leave HOMEPAGE_URL empty for JSON service info at /.
  "vars": { "PUBLIC_MCP_URL": "", "HOMEPAGE_URL": "" },
  // No paid resources, storage bindings, cron jobs, or container compute.
  // Run on a Workers Free account to keep hosting within the free allowance.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "invocation_logs": false,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true,
    },
    "issues": { "enabled": true },
  },
  // Maintainer deployment. Forks can use the default config or replace this domain.
  // Selected explicitly with --env production; no account IDs or credentials.
  "env": {
    "production": {
      "name": "sf-transit-mcp",
      "workers_dev": false,
      "preview_urls": false,
      // Owns the hostname by default. Other MCP Workers can take specific paths
      // using Cloudflare Routes, which run before this Custom Domain Worker.
      "routes": [
        {
          "pattern": "mcp.riv.lc",
          "zone_name": "riv.lc",
          "custom_domain": true,
        },
      ],
      "vars": {
        "PUBLIC_MCP_URL": "https://mcp.riv.lc/sf-transit/mcp",
        "HOMEPAGE_URL": "https://reindexventures.com",
      },
    },
  },
}
