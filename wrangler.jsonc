{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sf-transit-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  // Set only when a host needs an explicit stable widget origin. No secret.
  "vars": { "PUBLIC_MCP_URL": "" },
  // No paid resources, storage bindings, cron jobs, or container compute.
  // Run on a Workers Free account to keep hosting within the free allowance.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": { "invocation_logs": false },
  },
  // Maintainer deployment. Forks can use the default config or replace this domain.
  // Selected explicitly with --env production; no account IDs or credentials.
  "env": {
    "production": {
      "name": "sf-transit-mcp-production",
      "workers_dev": false,
      "preview_urls": false,
      // Owns the hostname by default. Other MCP Workers can take specific paths
      // using Cloudflare Routes, which run before this Custom Domain Worker.
      "routes": [{ "pattern": "lucas.czekaj.us", "custom_domain": true }],
      "vars": {
        "PUBLIC_MCP_URL": "https://lucas.czekaj.us/sf-transit/mcp",
      },
    },
  },
}
